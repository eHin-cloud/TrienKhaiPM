<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Nếu người dùng truy cập một file hoặc thư mục có thật thì cho qua luôn
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. API routes: Cho phép truy cập trực tiếp các file trong thư mục api
    RewriteRule ^api/ - [L]

    # 3. Các request còn lại đổ về index.php với tham số route
    RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
</IfModule>
